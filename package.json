{
  "name": "andrii-matviienko-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual DefTech and Front-End portfolio, built with Eleventy",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/styles/tailwind.css -o .cache/site.css --minify",
    "dev": "eleventy --serve --port=8080",
    "build": "eleventy",
    "check": "node scripts/check-site.mjs",
    "test:game": "node --test tests/game.test.mjs",
    "test": "npm run test:game && npm run build && npm run check"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@lucide/icons": "^1.73.0",
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
