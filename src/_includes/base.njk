{% set t = translations[variant.lang] %}
{% set p = t[variant.profile] %}
<!doctype html>
<html lang="{{ variant.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ p.title }}</title>
  <meta name="description" content="{{ p.description }}">
  <meta name="theme-color" content="#ffffff">
  <link rel="canonical" href="{{ variant.path | absoluteUrl }}">
  <link rel="alternate" hreflang="{{ variant.lang }}" href="{{ variant.path | absoluteUrl }}">
  <link rel="alternate" hreflang="{% if variant.lang == 'uk' %}en{% else %}uk{% endif %}" href="{{ variant.alternate | absoluteUrl }}">
  <link rel="alternate" hreflang="x-default" href="{% if variant.lang == 'uk' %}{{ variant.path | absoluteUrl }}{% else %}{{ variant.alternate | absoluteUrl }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ p.title }}">
  <meta property="og:description" content="{{ p.description }}">
  <meta property="og:url" content="{{ variant.path | absoluteUrl }}">
  <meta property="og:locale" content="{% if variant.lang == 'uk' %}uk_UA{% else %}en_US{% endif %}">
  <meta property="og:site_name" content="{{ t.name }} — {{ t.portfolio }}">
  <meta name="twitter:card" content="summary">
  {% include "favicons.njk" %}
  <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
</head>
<body id="top" class="profile-{{ variant.profile }}">
  <a class="skip-link" href="#main">{{ t.skip }}</a>
  <div class="page-shell pt-5 md:pt-9">
    <header class="site-header sticky top-3 z-30 grid grid-cols-[1fr_auto] items-center gap-x-3 gap-y-2 rounded-3xl border border-line bg-white px-4 py-3 supports-[backdrop-filter:blur(0)]:bg-white/82 supports-[backdrop-filter:blur(0)]:backdrop-blur-xl md:top-4 md:grid-cols-[1fr_auto_auto] md:gap-x-6 md:rounded-full md:px-5 md:py-3.5">
      <a class="flex min-h-11 items-center gap-3 rounded-md text-sm font-semibold md:text-base" href="{{ variant.path | url }}" aria-label="{{ t.name }} — {{ t.portfolio }}"><img class="h-9 w-9 rounded-full object-cover" src="{{ '/assets/portrait.png' | url }}" alt="" width="36" height="36"><span>{{ t.name }}</span></a>
      <nav class="main-nav col-span-2 row-start-2 flex items-center justify-between gap-1 md:col-span-1 md:col-start-2 md:row-start-1 md:gap-1.5" aria-label="{{ t.navigation }}">
        <a class="nav-link" href="#work">{{ t.work }}</a><a class="nav-link" href="{{ site.github }}" target="_blank" rel="noopener">GitHub {% icon "arrow-up-right", "", 12 %}</a><a class="nav-resume nav-link" href="{{ p.resumePath | url }}" target="_blank" rel="noopener">{{ t.resume }} {% icon "file-text", "", 14 %}</a><a class="nav-link" href="#contact">{{ t.contact }}</a>
      </nav>
      <nav class="languages col-start-2 row-start-1 flex items-center gap-1 text-[11px] md:col-start-3" aria-label="{{ t.languages }}">
        {% if variant.lang == 'uk' %}<a class="flex min-h-9 min-w-7 items-center justify-center rounded text-accent underline underline-offset-4" lang="uk" hreflang="uk" href="{{ variant.path | url }}" aria-current="page">UK</a><a class="flex min-h-9 min-w-7 items-center justify-center rounded text-muted hover:bg-surface hover:text-accent" lang="en" hreflang="en" href="{{ variant.alternate | url }}">EN</a>
        {% else %}<a class="flex min-h-9 min-w-7 items-center justify-center rounded text-muted hover:bg-surface hover:text-accent" lang="uk" hreflang="uk" href="{{ variant.alternate | url }}">UK</a><a class="flex min-h-9 min-w-7 items-center justify-center rounded text-accent underline underline-offset-4" lang="en" hreflang="en" href="{{ variant.path | url }}" aria-current="page">EN</a>{% endif %}
      </nav>
    </header>
    <main id="main" tabindex="-1">{{ content | safe }}</main>
    <footer class="site-footer flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-5 pb-[var(--dock-clearance)] text-[11px] text-muted">
      <span>© {{ year }} {{ t.name }}</span>
      {% if site.gameEnabled %}
      <div class="flex w-full items-center justify-between gap-3 sm:w-auto sm:justify-start"><button class="nav-link min-h-11 gap-2 disabled:cursor-wait disabled:opacity-60" type="button" data-game-launch aria-haspopup="dialog" aria-controls="flight-game" hidden>{% icon "drone", "", 18 %}{{ game[variant.lang].launch }}</button><a class="nav-link" href="#top">{{ t.top }} {% icon "arrow-up", "", 12 %}</a></div>
      <p class="w-full text-xs text-ink" role="status" data-game-load-error hidden>{{ game[variant.lang].loadError }}</p>
      {% else %}
      <a class="nav-link" href="#top">{{ t.top }} {% icon "arrow-up", "", 12 %}</a>
      {% endif %}
    </footer>
  </div>
  <nav class="profile-switch fixed left-1/2 z-50 flex -translate-x-1/2 items-center gap-1 rounded-full border border-line bg-white p-1.5 shadow-[0_4px_24px_#17231914]" aria-label="{{ t.profiles }}">
    <a class="profile-option" href="{{ variant.deftech | url }}" {% if variant.profile == 'deftech' %}aria-current="page"{% endif %}>{% icon "drone", "", 18 %}DefTech</a>
    <a class="profile-option" href="{{ variant.frontend | url }}" {% if variant.profile == 'frontend' %}aria-current="page"{% endif %}>{% icon "code-xml", "", 18 %}Front-End</a>
  </nav>
  {% if site.gameEnabled %}
  {% include "flight-game.njk" %}
  <script type="module" src="{{ '/assets/game/launch.js' | url }}"></script>
  {% endif %}
</body>
</html>
