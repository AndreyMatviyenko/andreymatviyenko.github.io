<div class="divide-y divide-line">
  {% for job in experience[variant.profile] %}
  <article class="experience-entry py-7 first:pt-0">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
      <div><h3 class="text-lg leading-snug font-medium md:text-xl">{{ job.company[variant.lang] or job.company }}</h3><p class="mt-1 text-[13px] leading-relaxed text-accent">{{ job.role[variant.lang] or job.role }}</p></div>
      <p class="text-xs leading-relaxed text-muted sm:max-w-48 sm:shrink-0 sm:text-right">{{ job[variant.lang] }}</p>
    </div>
    {% if job.description %}<p class="mt-4 max-w-[850px] text-sm leading-[1.8] text-muted">{{ job.description[variant.lang] }}</p>{% endif %}
    {% if job.projects %}
    <ul class="mt-4 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
      {% for project in job.projects %}
      <li><a id="{{ project.id }}" class="work-project-link group inline-flex min-h-11 items-center gap-2 rounded-sm text-sm font-medium text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent" href="{{ project.url }}" target="_blank" rel="noopener">{{ project.name }} {% icon "arrow-up-right", "transition-transform duration-200 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5", 14 %}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
  </article>
  {% endfor %}
</div>
