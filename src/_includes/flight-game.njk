{% set g = game[variant.lang] %}
<dialog id="flight-game" class="flight-dialog" data-flight-game data-game-copy="{{ g | dump | escape }}" data-game-state="closed" aria-labelledby="flight-title" aria-describedby="flight-description">
  <div class="flex shrink-0 items-start justify-between gap-4 px-4 pt-4 pb-3 md:px-6 md:pt-5 md:pb-4 [@media(max-height:420px)]:py-2">
    <div><h2 id="flight-title" class="flex items-center gap-3 text-xl leading-snug font-medium tracking-tight md:text-2xl">{% icon "drone", "text-accent", 24 %}{{ g.title }}</h2><p id="flight-description" class="mt-1.5 max-w-[540px] text-xs leading-relaxed text-muted md:text-sm [@media(max-height:420px)]:hidden">{{ g.description }}</p></div>
    <button class="flight-icon-button -mt-1 -mr-1" type="button" data-flight-close aria-label="{{ g.close }}">{% icon "x", "", 20 %}</button>
  </div>
  <dl class="grid shrink-0 grid-cols-4 gap-2 border-y border-line px-4 py-3 text-xs md:px-6">
    <div><dt class="text-muted">{{ g.score }}</dt><dd class="mt-1 text-lg leading-none font-medium tabular-nums md:text-xl"><output data-flight-score aria-live="off">0</output></dd></div>
    <div><dt class="text-muted">{{ g.time }}</dt><dd class="mt-1 text-lg leading-none font-medium tabular-nums md:text-xl"><output data-flight-time aria-live="off">00:00</output></dd></div>
    <div><dt class="text-muted">{{ g.lives }}</dt><dd class="mt-1 flex items-center gap-1.5 text-lg leading-none font-medium tabular-nums md:text-xl">{% icon "heart", "text-accent", 16 %}<output data-flight-lives aria-live="off">3</output></dd></div>
    <div><dt class="text-muted">{{ g.best }}</dt><dd class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-1"><output class="text-lg leading-none font-medium tabular-nums md:text-xl" data-flight-best aria-live="off">0</output><span class="text-[10px] leading-none text-muted tabular-nums" data-flight-best-time>00:00</span></dd></div>
  </dl>
  <div class="flight-stage relative min-h-0 flex-1 bg-surface [@media(max-height:300px)]:min-h-[160px] [@media(max-height:300px)]:flex-none" data-flight-stage>
    <canvas class="absolute inset-0 h-full w-full touch-none" data-flight-canvas tabindex="0" role="img" aria-label="{{ g.fieldLabel }}" aria-describedby="flight-controls">{{ g.fieldLabel }}</canvas>
    <div class="absolute inset-0 flex items-center justify-center bg-surface/50 p-4" data-flight-panel>
      <div class="w-full max-w-[360px] rounded-xl border border-line bg-white p-5 text-center md:p-7 [@media(max-height:420px)]:p-3">
        <h3 class="text-xl leading-snug font-medium tracking-tight md:text-2xl [@media(max-height:420px)]:text-lg" data-flight-panel-title>{{ g.readyTitle }}</h3>
        <p class="mt-3 text-[13px] leading-relaxed text-muted [@media(max-height:420px)]:mt-1 [@media(max-height:360px)]:hidden" data-flight-panel-text>{{ g.readyText }}</p>
        <button class="button button-primary mt-5 w-full gap-2 [@media(max-height:420px)]:mt-3" type="button" data-flight-primary>{% icon "play", "", 16 %}<span data-flight-primary-label>{{ g.start }}</span></button>
      </div>
    </div>
  </div>
  <div class="shrink-0 border-t border-line px-4 pt-3 pb-4 md:px-6 [@media(max-height:420px)]:py-2">
    <div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-3">
      <p id="flight-controls" class="max-w-[420px] text-[11px] leading-relaxed text-muted md:text-xs [@media(max-height:420px)]:hidden">{{ g.controls }}</p>
      <div class="flex gap-2">
        <button class="button gap-2 px-4 text-xs disabled:cursor-default disabled:opacity-40 disabled:hover:bg-transparent" type="button" data-flight-pause disabled><span data-flight-pause-icon>{% icon "pause", "", 14 %}</span><span data-flight-resume-icon hidden>{% icon "play", "", 14 %}</span><span data-flight-pause-label>{{ g.pause }}</span></button>
        <button class="button gap-2 px-4 text-xs disabled:cursor-default disabled:opacity-40 disabled:hover:bg-transparent" type="button" data-flight-restart disabled>{% icon "rotate-ccw", "", 14 %}{{ g.restart }}</button>
      </div>
    </div>
    <div class="mt-2 flex flex-wrap justify-between gap-x-4 gap-y-1 text-[10px] leading-relaxed text-muted [@media(max-height:420px)]:hidden"><p data-flight-record-note>{{ g.recordNote }}</p><p class="hidden sm:block">{{ g.shortcuts }}</p></div>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-flight-announcement></p>
</dialog>
