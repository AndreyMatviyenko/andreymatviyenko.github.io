---
pagination:
  data: variants
  size: 1
  alias: variant
permalink: "{{ variant.path }}index.html"
layout: base.njk
---
{% set t = translations[variant.lang] %}
{% set p = t[variant.profile] %}
<section id="about" class="pt-12 pb-14 md:pt-20 md:pb-20 motion-safe:animate-enter" aria-labelledby="intro-title">
  {% if p.availability %}<p class="mb-5 inline-flex max-w-full items-center gap-3 rounded-full border border-accent/15 bg-accent-soft px-4 py-2 text-[13px] leading-5 font-semibold text-accent">{% icon "search", "availability-search", 16 %}{{ p.availability }}</p>{% endif %}
  <h1 id="intro-title" class="text-2xl leading-[1.65] font-normal tracking-[-.02em] md:text-[32px]">{{ t.hello }} <strong class="font-semibold">{{ t.name }}</strong>{{ p.intro }}</h1>
  {% if variant.profile == 'frontend' %}
  <p class="mt-6 text-[17px] leading-[1.8] tracking-[-.01em] text-muted md:text-[22px]">{{ p.detail }} {% if p.featuredUrl %}<a class="text-link text-ink" href="{{ p.featuredUrl }}" target="_blank" rel="noopener">{{ p.featured }}</a>{% else %}<strong class="font-medium text-ink">{{ p.featured }}</strong>{% endif %}{{ p.featuredRest }}</p>
  <p class="mt-8 text-xl leading-relaxed tracking-[-.02em] md:text-[26px]"><a class="text-link" href="mailto:{{ site.email }}">{{ t.collaborate }}</a> {{ t.collaborateRest }}</p>
  {% endif %}
  <div class="mt-6 flex justify-end">
    <a class="resume-link button button-primary resume-button mt-0" href="{{ p.resumePath | url }}" target="_blank" rel="noopener">{% icon "file-text", "", 18 %} {{ t.resume }} <span class="resume-format">{{ t.resumeFormat }}</span></a>
  </div>
</section>
<section id="work" aria-labelledby="work-title">
  {% if variant.profile == 'frontend' %}
  <div id="experience">
    <div class="section-heading"><h2 id="work-title" class="section-title">{{ p.workTitle }}</h2><p>{{ p.experienceText }}</p></div>
    {% include "experience-entries.njk" %}
  </div>
  {% else %}
  <div class="section-heading"><h2 id="work-title" class="section-title">{{ p.workTitle or t.selectedWork }}</h2>{% if p.workNote %}<p>{{ p.workNote }}</p>{% endif %}</div>
  <div class="flex flex-col gap-6 md:gap-2">
  {% set imageIndex = 0 %}
  {% for project in projects[variant.profile] %}
    {% set projectName = project.name[variant.lang] or project.name %}
    {% if project.image %}{% set imageIndex = imageIndex + 1 %}{% endif %}
    {% set imageOnRight = project.image and imageIndex % 2 == 0 %}
    <article id="{{ project.id }}" class="project group/project{% if not project.image %} md:grid-cols-1{% elif imageOnRight %} md:grid-cols-[1.5fr_.9fr]{% endif %}">
      {% if project.image %}<div class="project-visual{% if imageOnRight %} md:order-2{% endif %}"{% if project.coverBackground %} style="--project-cover-bg: {{ project.coverBackground }}"{% endif %}>{% include "project-cover.njk" %}</div>{% endif %}
      <div{% if imageOnRight %} class="md:order-1"{% endif %}>
        <p class="text-[11px] leading-relaxed text-muted">{{ project.category[variant.lang] or project.category }}</p>
        <h3 class="mt-2 text-[27px] leading-tight font-medium tracking-[-.025em] md:text-[31px]">{% if project.url %}<a class="group inline-block rounded-sm transition-colors duration-200 hover:text-accent" href="{{ project.url }}" target="_blank" rel="noopener">{{ projectName }} {% icon "arrow-up-right", "ml-1 text-accent transition-transform duration-200 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5", 20 %}</a>{% else %}{{ projectName }}{% endif %}</h3>
        <p class="mt-4 max-w-[580px] text-[14px] leading-[1.8] text-muted">{{ project[variant.lang] }}</p>
        {% if project.tags.length %}<ul class="project-tags" aria-label="{{ t.skillsTitle }}">{% for tag in project.tags %}<li>{{ tag[variant.lang] or tag }}</li>{% endfor %}</ul>{% endif %}
        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">{% if project.status %}<span class="project-status">{{ t[project.status] }}</span>{% endif %}{% if project.url %}<a class="project-link" href="{{ project.url }}" target="_blank" rel="noopener">{{ t[project.linkLabel] }} {% icon "arrow-up-right", "", 14 %}</a>{% endif %}</div>
      </div>
    </article>
  {% endfor %}
  </div>
  {% endif %}
</section>
{% if variant.profile == 'frontend' %}
<section id="personal-projects" class="mt-14 border-t border-line pt-8 md:mt-20 md:pt-9" aria-labelledby="personal-projects-title">
  <div class="section-heading"><h2 id="personal-projects-title" class="section-title">{{ p.personalProjectsTitle }}</h2><p>{{ p.personalProjectsNote }}</p></div>
  <div class="grid gap-6 md:grid-cols-2 md:gap-10">
    {% for project in projects.personal %}
    <article id="{{ project.id }}" class="personal-project -mx-3 flex flex-col items-start rounded-xl p-3 transition-colors duration-200 hover:bg-surface focus-within:bg-surface md:-mx-5 md:p-5">
      <p class="text-[11px] leading-relaxed text-muted">{{ project.category[variant.lang] }}</p>
      <h3 class="mt-2 text-[27px] leading-tight font-medium tracking-[-.025em] md:text-[31px]"><a class="group inline-block rounded-sm transition-colors duration-200 hover:text-accent" href="{{ project.url }}" target="_blank" rel="noopener">{{ project.name }} {% icon "arrow-up-right", "ml-1 text-accent transition-transform duration-200 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5", 20 %}</a></h3>
      <p class="mt-4 text-sm leading-[1.8] text-muted">{{ project[variant.lang] }}</p>
      <ul class="project-tags" aria-label="{{ t.skillsTitle }}">{% for tag in project.tags %}<li>{{ tag[variant.lang] or tag }}</li>{% endfor %}</ul>
      <a class="project-link mt-auto min-h-11 pt-4" href="{{ project.url }}" target="_blank" rel="noopener">{{ t.visit }} {% icon "arrow-up-right", "", 14 %}</a>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}
{% if variant.profile == 'frontend' %}
<section id="background" class="mt-14 border-t border-line pt-8 md:mt-20 md:pt-9" aria-labelledby="background-title">
  <div class="section-heading"><h2 id="background-title" class="section-title">{{ p.backgroundTitle }}</h2></div>
{% else %}
<section id="experience" class="mt-14 border-t border-line pt-8 md:mt-20 md:pt-9" aria-labelledby="experience-title">
  <div class="section-heading"><h2 id="experience-title" class="section-title">{{ t.experience }}</h2><p>{{ p.experienceText }}</p></div>
  {% include "experience-entries.njk" %}
{% endif %}
  <div class="experience-details grid gap-8{% if variant.profile == 'deftech' %} border-t border-line pt-8{% endif %} md:grid-cols-2 md:gap-16">
    <div class="space-y-8">
      <div><h3 class="mb-3 text-[15px] font-medium">{{ t.toolsTitle }}</h3><ul class="flex list-none flex-wrap gap-2 p-0">{% for skill in p.skills %}<li class="skills-tag px-3 py-1.5 text-xs">{{ skill }}</li>{% endfor %}</ul></div>
      <div><h3 class="mb-3 text-[15px] font-medium">{{ t.spokenLanguagesTitle }}</h3><dl class="space-y-2 text-sm leading-relaxed">{% for language in t.spokenLanguages %}<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1"><dt>{{ language.name }}</dt><dd class="text-muted">{{ language.level }}</dd></div>{% endfor %}</dl></div>
    </div>
    <div class="space-y-7">
      <div>
        <h3 class="mb-2 text-[15px] font-medium">{{ t.education }}</h3>
        <div class="space-y-2 text-sm leading-relaxed text-muted">
          <p><strong class="font-semibold text-ink">{{ t.educationDetails.institution }}:</strong><br>{{ t.educationDetails.period }} | {{ t.educationDetails.degree }}</p>
          <p>{{ t.educationDetails.field }}</p>
          <p>{{ t.educationDetails.specialization }}</p>
        </div>
      </div>
      {% if variant.profile == 'deftech' %}
      <div><h3 class="mb-2 text-[15px] font-medium">{{ t.training }}</h3><p class="text-sm leading-relaxed text-muted">{{ t.trainingText }}</p></div>
      <div><h3 class="mb-2 text-[15px] font-medium">{{ t.recognitionTitle }}</h3><p class="text-sm leading-relaxed text-muted">{{ t.recognitionText }}</p></div>
      {% endif %}
    </div>
  </div>
  <div class="mt-16"><a class="resume-link button button-primary resume-button mt-0 min-h-20 w-full py-5 text-lg" href="{{ p.resumePath | url }}" target="_blank" rel="noopener">{% icon "file-text", "", 20 %} {{ t.resume }} <span class="resume-format">{{ t.resumeFormat }}</span></a></div>
</section>
<section id="contact" class="mt-14 border-t border-line pt-8 pb-10 md:mt-20 md:pb-12" aria-labelledby="contact-title">
  <h2 id="contact-title" class="section-title">{{ t.contactTitle }}</h2>
  <p class="mt-3 text-sm leading-relaxed text-muted">{{ t.contactText }}</p>
  <div class="mt-6"><a class="text-link inline-flex min-h-11 max-w-full items-center text-[clamp(17px,2.1vw,25px)] break-words text-accent" href="mailto:{{ site.email }}">{{ site.email }}</a></div>
</section>
